---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
import posts from '../posts.json'


const recentPosts = posts.slice(0, 20);

const rows = [];
let i = 0;
let two = true;

while (i < recentPosts.length) {
  const size = two ? 3 : 2;
  rows.push(recentPosts.slice(i, i + size));
  i += size;
  two = !two;
}
---

<Layout title="Rachel Johnson">
	<main>
		<h1> <span class="title">Rachel Johnson</span></h1>
		<p class="info">
			<a href="mailto:rachel@rachelejohnson.com">Email</a>
			<span class="separator">&#x25CB;</span>

			<a href="/archive">All Posts</a>
			<span class="separator">&#x25CB;</span>

			<a href="/feed.xml">RSS</a>
		</p>
		{
			rows.map((row) => (
				<ul
				role="list"
				class={`post-row ${row.length === 2 ? "two" : "three"}`}
				>
				{row.map(post => (
					<Card
					href={post.href}
					title={post.title}
					image={post.image}
					/>
				))}
				</ul>
			))
		}
	</main>
</Layout>

<style>
	main {
		margin: auto;
		padding: 1rem;
		width: 800px;
		max-width: calc(100% - 2rem);
		color: white;
		font-size: 20px;
		line-height: 1.3;
	}
	a {
	color: var(--accent);
	text-decoration: none;
	}
	a:focus,
	a:hover {
	color: var(--accent-yellow);
	text-decoration: none;
	}
	.astro-a {
		position: absolute;
		top: -32px;
		left: 50%;
		transform: translatex(-50%);
		width: 220px;
		height: auto;
		z-index: -1;
	}
	h1 {
		font-size: 5rem;
		line-height: 1;
		text-align: center;
		margin-bottom: .5em;
	}
	.title {
		font-family: "Fraunces", "Koh Santepheap", serif;
		font-weight: 600;
  		font-style: normal;
		padding:8px;
	}
	.info {
		font-family: "Fraunces", "Koh Santepheap", serif;
		font-size: 1.5em;
		margin-bottom: 2rem;
		border-radius: 125px;
		text-align: center;
		font-weight: 500;
	}
	.info code{
		font-size: 1.5em;
		font-weight: bold;
		background: rgba(var(--accent-light), 12%);
		color: rgb(var(--accent-light));
		border-radius: 4px;
		padding: 0.3em 0.4em;
	}
	.info strong {
		color: rgb(var(--accent-light));
	}

	.link-card {
		width: min(18rem, 90vw);
		height: min(18rem, 90vw);
	}
	.post-row {
		display: flex;
		justify-content: center;
		gap: 2rem;
		padding: 0;
		list-style: none;
	}
	@media (max-width: 749px) {
		.post-row {
			flex-wrap: wrap;
		}
		.link-card {
			width: min(18rem, 90vw);
			height: min(18rem, 90vw);
		}
		.info {
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: 0.4rem;
		}
		.separator {
			display: none;
		}
		h1 {
			font-size: 2.5rem;
		}
	}
</style>
